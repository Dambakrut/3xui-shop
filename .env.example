BOT_TOKEN="1234567890:qwerty"
# Required in this application's webhook mode: random 1-256 chars (A-Z, a-z, 0-9, _, -).
BOT_WEBHOOK_SECRET=
# Optional comma-separated IPs/CIDRs of your own payment reverse proxies. Empty = trust no proxy headers.
PAYMENT_TRUSTED_PROXY_NETWORKS=
BOT_DEV_ID=123456789
BOT_SUPPORT_ID=123456789
BOT_DOMAIN=3xui-shop.com

XUI_USERNAME=admin
XUI_PASSWORD=admin
# Panel API authentication: session (default) or token.
# Token mode requires a separate 3x-ui API token with admin scope for client writes.
# Legacy XUI_TOKEN/loginSecret is not an API Bearer token.
XUI_AUTH_MODE=session
XUI_API_TOKEN=
# Required: ID of the existing inbound dedicated to new shop clients (integer > 0).
XUI_INBOUND_ID=
# Optional explicit HTTPS subscription base, including custom path and trailing /.
# If empty, the panel's configured subURI is read; no /user/ fallback is used.
XUI_SUBSCRIPTION_BASE_URL=

LETSENCRYPT_EMAIL=example@email.com

# Optional SQLite directory; default: app/data. Use a separate directory for local tests.
# DB_DATA_DIR=
# Disabled payment gateways do not require credentials; Stars is enabled by default.
